APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Dar_es_Salaam

# Base URL prepended to every stored media path (car photos, logos, videos).
# Leave unset locally — APP_URL is used as the fallback.
# On cPanel where the document root is the project root (NOT the public/ folder),
# set this to the domain + /public so media links resolve correctly:
#   MEDIA_BASE_URL=https://tgworld.e-saloon.online/public
# MEDIA_BASE_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite (default for quick local setup — run migrations after `touch database/database.sqlite` or composer post-install):
DB_CONNECTION=sqlite
# MySQL/MariaDB — create the schema first: CREATE DATABASE tg_world_database;
# Then comment sqlite above and use:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tg_world_database
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=tgworld_session
SESSION_HTTP_ONLY=true
# Production (Netlify frontend + separate API): true and none.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
AUTH_SESSION_LIFETIME=10080
AUTH_PASSWORD_RESET_EXPIRE=30
FRONTEND_URL=https://tgworld.netlify.app
FRONTEND_LOCAL_URL=http://localhost:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
QUOTATION_NOTIFICATION_EMAIL="dashboard@example.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Live → Local data pull (LOCAL DEV ONLY) ─────────────────────────────────
# Leave LIVE_APP_URL empty on production. Sync pull is disabled unless both are set.
# LIVE_APP_URL=https://tgworld.e-saloon.online
# SYNC_PULL_ENABLED=true
# SYNC_PEER_URL=https://tgworld.e-saloon.online
# SYNC_SECRET=your-shared-secret
LIVE_APP_URL=
SYNC_PULL_ENABLED=false
SYNC_PEER_URL=
SYNC_SECRET=
